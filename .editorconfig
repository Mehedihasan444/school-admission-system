root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,json,ts,tsx,js,jsx,html,css,yml,yaml,md}]
indent_size = 2

[backend/src/Admission.Api/Infrastructure/Persistence/Migrations/*.cs]
dotnet_diagnostic.CA1861.severity = suggestion

